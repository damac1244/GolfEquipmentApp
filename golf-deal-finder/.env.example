# Copy to .env and fill in as each affiliate program approves you.
# The app runs with NONE of these set -- it falls back to the sample feed.

# Your sub-id, appended to outbound links so you can tell which products earn.
GOLF_SUB_ID=golfdeals

# --- AvantLink -------------------------------------------------------------
# Carries many independent golf specialists (the ones that actually discount).
# Credentials: AvantLink dashboard -> Tools -> API
AVANTLINK_AFFILIATE_ID=
AVANTLINK_WEBSITE_ID=
AVANTLINK_AUTH_KEY=
# Optional: comma-separated merchant ids to restrict the pull.
AVANTLINK_MERCHANT_IDS=

# --- Impact ----------------------------------------------------------------
# Hosts PGA TOUR Superstore and TaylorMade, among others.
# Credentials: Impact -> Settings -> API Access (AccountSid + AuthToken)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# Optional: comma-separated catalog ids. Leave blank to pull every catalog you
# have access to (slow on the first run).
IMPACT_CATALOG_IDS=

# --- CJ Affiliate ----------------------------------------------------------
# Hosts Golf Direct Now and the Puma/Cobra family.
# Token: developers.cj.com -> Personal Access Token
CJ_PERSONAL_ACCESS_TOKEN=
CJ_COMPANY_ID=
# Optional: comma-separated advertiser (CID) ids. Strongly recommended --
# without it you pull every advertiser you're joined to.
CJ_PARTNER_IDS=

# --- Misc ------------------------------------------------------------------
GOLF_DB_PATH=
GOLF_HTTP_TIMEOUT=30
